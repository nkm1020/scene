# Required for `npm run demo` and the web app: a Model API key from https://dev.meta.ai (Standard tier).
META_API_KEY=

# Voice synthesis (Qwen3-TTS service from tts/). Leave empty to run captions-only (`--voice none` behaviour).
TTS_URL=
TTS_TOKEN=

# Web app only (Supabase project; see supabase/migrations/0001_init.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
