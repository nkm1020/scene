# Required for `npm run demo` and the web app: a Model API key from https://dev.meta.ai (Standard tier).
META_API_KEY=

# Voice synthesis, one of: OpenAI gpt-4o-mini-tts (preset voices), or the Qwen3-TTS service from tts/ (clones a
# registered voice). Leave both empty to run captions-only (`--voice none` behaviour). Every line is read back by
# Muse Voice Transcribe before it plays, whichever speaks it.
OPENAI_API_KEY=
TTS_URL=
TTS_TOKEN=

# Web app only (Supabase project; see supabase/migrations/0001_init.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3D meshes (SAM 3D Objects on fal.ai)
FAL_KEY=
